# Create a breakpoint in a function.  Update the source such that the
# previous breakpoint line is now outside of all functions, recompile,
# and reload the executable.
#
# GDB should correctly spot that the source has been updated and find
# the new breakpoint location.

# This test restarts the inferior with 'start'.  This doesn't work
# when using plain 'gdbserver'.
require !use_gdb_stub

load_lib "source-tracking.exp"

standard_testfile -1.c -2.c

set build_srcfile [standard_output_file ${testfile}.c]

remote_exec build "cp $srcdir/$subdir/$srcfile $build_srcfile"

if { [prepare_for_testing "failed to prepare" $testfile $build_srcfile] } {
    return
}

if {![runto_main]} {
    return
}

gdb_test_no_output "set breakpoint source-tracking enabled on" \
    "enable source tracking breakpoints"

# Get initial breakpoint line numbers.
set lineno [gdb_get_line_number "/* Breakpoint here.  */" $build_srcfile]

gdb_breakpoint ${build_srcfile}:${lineno}
set bp_num [get_integer_valueof "\$bpnum" "*UNKNOWN*" \
		"get number for breakpoint"]

check_bp_tracked $bp_num $lineno $build_srcfile \
    "breakpoint is initially tracking the expected line"

# Copy in the updated source file and rebuild.
if {[replace_source_and_rebuild $srcfile2 $build_srcfile] == -1} {
    return
}

# Reload the executable, this will update the source tracking
# breakpoints.
gdb_test "with confirm off -- start" ".*" \
    "start after changing main source file"

# Get updated breakpoint line.
set lineno [gdb_get_line_number "/* Breakpoint here.  */" $build_srcfile]

check_bp_tracked $bp_num $lineno $build_srcfile \
    "breakpoint is tracking the updated line"
