# Start and inferior.  Create a breakpoint.  Update the source file,
# but don't recompile the executable.  Restart the inferior.
#
# GDB should warn that the source is newer than the executable and
# should disable source tracking.

# This test restarts the inferior with 'start'.  This doesn't work
# when using plain 'gdbserver'.
require !use_gdb_stub

load_lib "source-tracking.exp"

standard_testfile -1.c -2.c

set build_srcfile [standard_output_file ${testfile}.c]

remote_exec build "cp $srcdir/$subdir/$srcfile $build_srcfile"

if { [prepare_for_testing "failed to prepare" $testfile $build_srcfile] } {
    return
}

if {![runto_main]} {
    return
}

gdb_test_no_output "set breakpoint source-tracking enabled on" \
    "enable source tracking breakpoints"

# Get initial breakpoint line numbers.
set lineno [gdb_get_line_number "/* Breakpoint here.  */" $build_srcfile]

gdb_breakpoint ${build_srcfile}:${lineno}
set bp_num [get_integer_valueof "\$bpnum" "*UNKNOWN*" \
		"get number for breakpoint"]

check_bp_tracked $bp_num $lineno $build_srcfile \
    "breakpoint is initially tracking the expected line"

# Copy in the updated source file, but don't rebuild.
replace_source $srcfile2 $build_srcfile

# Reload the executable, this will ...
if {[gdb_start_cmd] < 0} {
    fail "restart inferior"
    return
}

set saw_disabled_warning false
gdb_test_multiple "" "soure tracking was disabled" -lbl {
    -re "\r\nwarning: source file is newer than the executable, source tracking disabled for breakpoint ${bp_num}(?=\r\n)" {
	set saw_disabled_warning true
	exp_continue
    }

    -re "\r\n$gdb_prompt $" {
	gdb_assert { $saw_disabled_warning } $gdb_test_name
    }
}

gdb_test "maint info source-tracking-context $bp_num" \
    "Breakpoint $bp_num does not have source tracking enabled\\." \
    "check breakpoint is no longer source tracked"

delete_breakpoints

gdb_breakpoint ${build_srcfile}:${lineno}
set bp_num [get_integer_valueof "\$bpnum" "*UNKNOWN*" \
		"get number for breakpoint after source update"]

# This breakpoint should not be tracked as the source is newer than
# the executable.  But it is right now, this a bug.
gdb_test "maint info source-tracking-context $bp_num" \
    "Breakpoint $bp_num does not have source tracking enabled\\." \
    "check breakpoint is not tracked"
