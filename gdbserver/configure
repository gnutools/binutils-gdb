    {
      return 42;
    }

    [[nodiscard]] int f2()
    {
      [[maybe_unused]] auto unused = f1();

      switch (f1())
      {
      case 17:
	f1();
	[[fallthrough]];
      case 42:
	f1();
      }
      return f1();
    }

