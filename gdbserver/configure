fi
{ printf '%s\n' "$as_me:${as_lineno-$LINENO}: result: $ac_cv_libxxhash" >&5
printf '%s\n' "$ac_cv_libxxhash" >&6; }
  if test "$ac_cv_libxxhash" = yes; then
